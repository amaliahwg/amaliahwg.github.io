---
import Base from '../../layouts/Base.astro';
import ProfileCard from '../../components/ProfileCard.astro';

const education = [
  {
    period: '2022 – 2026',
    degree: 'Ph.D.',
    org: 'Department of Software and Communications Engineering, Hongik University, South Korea',
    thesis:
      'Thesis: QoS-Aware Multicast Routing Protocols for Future Mobile Wireless Networks: A Deep Learning Approach',
  },
  {
    period: '2016 – 2018',
    degree: 'Master of Applied Engineering',
    org: 'Department of Electrical Engineering, Politeknik Negeri Malang, Indonesia',
    thesis: 'Thesis: Numerical Analysis of IFA for UHF and SHF Channel Systems',
  },
  {
    period: '2015 – 2016',
    degree: 'Bachelor of Applied Science',
    org: 'Department of Informatics Engineering, Politeknik Negeri Malang, Indonesia',
    thesis:
      'Thesis: Development of a Home Ownership Credit Eligibility System Using the SAW (Simple Additive Weighting) Method (Case Study: PT. Bank Syariah Bukopin, Sidoarjo Branch)',
  },
  {
    period: '2010 – 2013',
    degree: 'Associate Degree of Applied Science',
    org: 'Department of Computer Engineering, Telkom University, Bandung, Indonesia',
    thesis:
      'Thesis: Analysis and Implementation of Quality of Service (QoS) on a MAN Network Using a Huawei Router (Case Study: Telkom RDC Gegerkalong, Bandung)',
  },
];

const experience = [
  {
    period: 'March 2026 – Now',
    role: 'Postdoc Researcher',
    org: 'AI Security Convergence Lab, Hankyong National University, Gyeonggi-do, Republic of Korea',
  },
  {
    period: '2019 – 2022',
    role: 'Lecturer',
    org: 'Department of Electrical Engineering, Politeknik Negeri Malang, Indonesia',
    detail:
      'Taught Antenna, Artificial Intelligence, Modulation System, Broadband, Transmission Line, and Network Security System.',
  },
  {
    period: '2014 – 2015',
    role: 'IT Staff',
    org: 'Syariah Bukopin Bank, Surabaya, Indonesia',
  },
  {
    period: 'March – June 2013',
    role: 'Internship, Transmission Lab',
    org: 'PT. Telkom RDC Gegerkalong, Bandung, Indonesia',
    detail: 'Configured QoS with DSCP and 802.1p marking on a Huawei Router.',
  },
];

const scholarships = [
  { period: '2022 – 2026', label: 'Global Scholarship for Ph.D. Program, Hongik University, South Korea' },
  { period: '2016 – 2018', label: 'Scholarship for Master Program, Politeknik Negeri Malang, Indonesia' },
];

const certifications = [
  { period: '2015', label: 'Cisco Certified Network Associate (CCNA 1–4)' },
  { period: '2013', label: 'Juniper Networks Certified Associate (JNCIA-Junos)' },
];

const skills = [
  { label: 'Languages', value: 'Bahasa Indonesia, English, Korean' },
  { label: 'Coding Languages', value: 'C/C++, Python, MATLAB, Java, PHP' },
  { label: 'Simulators', value: 'NS3, Packet Tracer, WIPL-D' },
  { label: 'Deep Learning Tools', value: 'VS Code, Spyder, MATLAB' },
  { label: 'Web Programming Tools', value: 'VS Code, NetBeans, Eclipse IDE' },
  { label: 'UI/UX Programming Tools', value: 'Android Studio, Visual Studio' },
];
---

<Base title="Profile">
  <ProfileCard />

  <section class="section">
    <h2>Education</h2>
    <ul class="timeline">
      {
        education.map((item) => (
          <li>
            <span class="period">{item.period}</span>
            <strong>{item.degree}</strong>
            <p class="org">{item.org}</p>
            <p class="thesis">{item.thesis}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Work Experience</h2>
    <ul class="timeline">
      {
        experience.map((item) => (
          <li>
            <span class="period">{item.period}</span>
            <strong>{item.role}</strong>
            <p class="org">{item.org}</p>
            {item.detail && <p class="thesis">{item.detail}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Scholarships</h2>
    <ul class="plain-list">
      {
        scholarships.map((item) => (
          <li>
            <span class="period">{item.period}</span> {item.label}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Certifications</h2>
    <ul class="plain-list">
      {
        certifications.map((item) => (
          <li>
            <span class="period">{item.period}</span> {item.label}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Skills</h2>
    <dl class="skills">
      {
        skills.map((item) => (
          <>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .timeline li:last-child {
    border-bottom: none;
  }

  .period {
    display: block;
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 0.15rem;
  }

  .org {
    margin: 0.2rem 0 0;
    color: var(--color-text-muted);
  }

  .thesis {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .plain-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .plain-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .plain-list li:last-child {
    border-bottom: none;
  }

  .plain-list .period {
    display: inline;
    margin-right: 0.5rem;
  }

  .skills {
    display: grid;
    grid-template-columns: minmax(140px, 200px) 1fr;
    row-gap: 0.6rem;
    column-gap: 1rem;
    margin: 0;
  }

  .skills dt {
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .skills dd {
    margin: 0;
  }
</style>

---
import Base from '../../layouts/Base.astro';

const courses = [
  { en: 'Antenna', kr: '안테나' },
  { en: 'Artificial Intelligence', kr: '인공지능' },
  { en: 'Modulation System', kr: '변조 시스템' },
  { en: 'Broadband', kr: '광대역 통신' },
  { en: 'Transmission Line', kr: '전송선로' },
  { en: 'Network Security System', kr: '네트워크 보안 시스템' },
];
---

<Base title="Teaching">
  <h1>Teaching</h1>
  <p class="intro">
    Department of Electrical Engineering, Politeknik Negeri Malang, Indonesia (2019 – 2022)
  </p>
  <p class="intro">
    Courses covering fundamental and applied topics in telecommunications, wireless systems, and network
    security.
  </p>

  <section class="section">
    <h2>Courses Taught</h2>
    <div class="course-grid">
      {
        courses.map((course) => (
          <div class="course-card">
            <h3>{course.en}</h3>
            <p class="kr">{course.kr}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    color: var(--color-text-muted);
    margin: 0.25rem 0;
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .course-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
    background: var(--color-bg-alt);
  }

  .course-card h3 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
    color: var(--color-accent-dark);
  }

  .kr {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>

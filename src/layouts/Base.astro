---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Amalia — Postdoctoral Researcher in Wireless Communications' } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/profile/', label: 'Profile' },
  { href: '/publications/', label: 'Publications' },
  { href: '/teaching/', label: 'Teaching' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Amalia</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav">
        <a class="brand" href="/">Amalia</a>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; 2026 Amalia. All rights reserved.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-accent: #7a1f2b;
    --color-accent-dark: #5c1520;
    --color-text: #24262b;
    --color-text-muted: #5b5f68;
    --color-bg: #fdfcfb;
    --color-bg-alt: #f5f1ee;
    --color-border: #e5e0db;
    --max-width: 760px;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  h1, h2, h3 {
    line-height: 1.25;
    font-weight: 700;
  }

  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .site-nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .site-nav .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--color-accent);
    text-decoration: none;
  }

  .site-footer {
    text-align: center;
    padding: 2rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--color-border);
  }

  .section {
    margin-top: 2.5rem;
  }

  .section:first-of-type {
    margin-top: 0;
  }

  .section h2 {
    font-size: 1.3rem;
    color: var(--color-accent-dark);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.4rem;
    margin-bottom: 1.25rem;
  }
</style>
